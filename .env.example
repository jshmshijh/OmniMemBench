# === LLM Configuration ===
# OpenAI-compatible API endpoint (works with vLLM, Ollama, OpenRouter, etc.)
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=

# === Embedding Server ===
EMB_SERVER_URL=http://localhost:8010/v1
# Local path or Hugging Face ID of nvidia/omni-embed-nemotron-3b (retrieval encoder)
EMB_MODEL_PATH=

# === Evaluation ===
# Paper judge: GLM-5.2, temperature 0. Configure its endpoint and key separately.
# Blank endpoint/key values fall back to LLM_API_BASE / LLM_API_KEY for a shared gateway.
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=glm-5.2

# === Data Paths (optional, defaults to relative paths) ===
# DATA_ROOT=./data
# MODEL_PATH=

# === HuggingFace (for rebuild_multimodal) ===
# HF_ENDPOINT=https://huggingface.co
# HF_TOKEN=
# OMNIMEMBENCH_HF_REPO=jshmsjh/OmniMemBench
